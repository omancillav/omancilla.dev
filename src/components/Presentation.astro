---
import Badge from '@/components/Badge.astro'
import GitHubIcon from '@/assets/GitHub.astro'
import LinkedInIcon from '@/assets/LinkedIn.astro'
import MailIcon from '@/assets/Mail.astro'
import ArrowDownIcon from '@/assets/ArrowDown.astro'
import SocialPill from '@/components/Pill.astro'
import ProfileCard from '@/components/react/ProfileCard'
import { getLangFromUrl, useTranslations } from '@/i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<div class="w-full md:pb-12">
  <div class="relative z-10 grid w-full items-center gap-6 md:grid-cols-[minmax(0,1fr)_280px] md:gap-12 lg:grid-cols-[minmax(0,1fr)_320px]">
    <div>
      <div class="mb-5 md:mb-6" data-reveal="zoom" style="--reveal-delay: 0">
        <Badge>{t('hero.badge')}</Badge>
      </div>
      <h1 class="text-slate-950 dark:text-white text-3xl md:text-5xl font-bold" data-reveal style="--reveal-delay: 100">
        {t('hero.greeting')} <span class="text-sky-600 dark:text-sky-400/85">Omar Mancilla</span>
      </h1>
      <h2 class="mt-4 text-lg leading-7 text-slate-700 text-pretty md:text-xl md:leading-normal dark:text-white dark:opacity-80" data-reveal style="--reveal-delay: 200">
        <span class="text-yellow-500 dark:text-yellow-200">{t('hero.experience')}</span>{t('hero.student')}
        <span class="text-emerald-600 dark:text-green-300">{t('hero.country')}</span>
        <span class="opacity-85">
          {t('hero.focus')}
        </span>
      </h2>
      <nav class="mt-6 flex flex-wrap gap-x-2 gap-y-3 md:mt-8 md:gap-x-4 md:gap-y-4" data-reveal style="--reveal-delay: 300">
        <SocialPill href="https://github.com/omancillav">
          <GitHubIcon class="size-4 md:size-5" />
          GitHub
        </SocialPill>
        <SocialPill href="https://www.linkedin.com/in/omancilla">
          <LinkedInIcon class="size-4 md:size-5" />
          LinkedIn
        </SocialPill>
        <SocialPill href="mailto:contacto@omancilla.dev">
          <MailIcon class="size-4 md:size-5" />
          {t('hero.contact')}
        </SocialPill>
      </nav>
    </div>

    <div class="flex justify-center md:justify-end" data-reveal="right" style="--reveal-delay: 150">
      <ProfileCard
        client:visible
        avatarUrl="/assets/profile-card/avatar-cutout.webp"
        iconUrl="/assets/profile-card/icon-pattern.png"
        grainUrl="/assets/profile-card/grain.webp"
        name="Omar Mancilla"
        title={t('hero.role')}
        showUserInfo={false}
        enableTouchTilt={true}
        enableMobileTilt={false}
        className="w-[min(68vw,230px)] md:w-[280px] lg:w-[320px]"
      />
    </div>
  </div>

  <a
    href="#experience"
    aria-label={t('hero.goToExperience')}
    class="absolute bottom-1 left-1/2 hidden -translate-x-1/2 rounded-full p-2 text-slate-600 transition hover:text-slate-950 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-sky-500 motion-safe:animate-bounce md:block dark:text-white/75 dark:hover:text-white"
  >
    <ArrowDownIcon class="size-7 md:size-8" aria-hidden="true" />
  </a>
</div>
