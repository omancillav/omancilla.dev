---
import ThemeToggle from '@/components/ThemeToggle.astro'
import LanguageToggle from '@/components/LanguageToggle.astro'
import MenuIcon from '@/assets/Menu.astro'
import { getLangFromUrl, useTranslations } from '@/i18n/utils'

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<header class="fixed top-4 inset-x-4 z-50 flex justify-center">
  <nav
    class="isolate flex flex-row items-center gap-3 px-4 pr-3 py-2 rounded-full
    max-[360px]:gap-2 max-[360px]:px-3 max-[360px]:pr-2 max-[360px]:py-1.5 md:gap-5 md:px-5 md:pr-5 md:py-1 md:leading-none
    bg-white/55 backdrop-blur-xl backdrop-saturate-200 border border-white/5 shadow-[0_10px_35px_rgba(15,23,42,0.16),inset_0_1px_0_rgba(255,255,255,0.82)]
    text-[14px] max-[360px]:text-[13px] text-slate-700 hover:text-slate-950
    dark:bg-white/[0.08] dark:backdrop-saturate-100 dark:border-white/15 dark:shadow-[0_10px_35px_rgba(0,0,0,0.22),inset_0_1px_0_rgba(255,255,255,0.18)] dark:text-white/90 dark:hover:text-white"
  >
    <a href="#inicio" class="transition-colors duration-200 font-medium whitespace-nowrap"> {t('nav.home')} </a>
    <a href="#experience" class="transition-colors duration-200 font-medium whitespace-nowrap"> {t('nav.experience')} </a>
    <a href="#projects" class="transition-colors duration-200 font-medium whitespace-nowrap"> {t('nav.projects')} </a>
    <a href="#stack" class="transition-colors duration-200 font-medium whitespace-nowrap"> {t('nav.stack')} </a>
    <span aria-hidden="true" class="h-4 max-[360px]:h-3.5 w-px bg-slate-900/15 dark:bg-white/15"></span>

    <div class="hidden md:flex items-center gap-2">
      <LanguageToggle />
      <ThemeToggle />
    </div>

    <div class="relative md:hidden">
      <button
        id="controls-trigger"
        type="button"
        aria-label={t('nav.settings')}
        aria-haspopup="true"
        aria-expanded="false"
        class="grid size-6 max-[360px]:size-5 place-items-center text-slate-800 transition hover:scale-110 hover:text-slate-950
        focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-500
        dark:text-white dark:hover:text-white"
      >
        <MenuIcon class="size-4.5 max-[360px]:size-4" aria-hidden="true" />
      </button>

      <div
        id="controls-panel"
        class="hidden absolute right-0 top-[calc(100%+0.75rem)] flex items-center gap-3 rounded-full px-3 py-2
        bg-white/90 backdrop-blur-xl backdrop-saturate-200 border border-white/10 shadow-[0_10px_35px_rgba(15,23,42,0.16)]
        dark:bg-slate-900/90 dark:border-white/15"
      >
        <LanguageToggle />
        <ThemeToggle />
      </div>
    </div>
  </nav>
</header>

<script>
const trigger = document.getElementById('controls-trigger')
const panel = document.getElementById('controls-panel')

trigger?.addEventListener('click', (event) => {
  event.stopPropagation()
  const isNowHidden = panel?.classList.toggle('hidden')
  trigger.setAttribute('aria-expanded', String(!isNowHidden))
})

document.addEventListener('click', (event) => {
  if (!panel || panel.classList.contains('hidden')) return
  if (panel.contains(event.target) || trigger?.contains(event.target)) return
  panel.classList.add('hidden')
  trigger?.setAttribute('aria-expanded', 'false')
})

document.addEventListener('keydown', (event) => {
  if (event.key !== 'Escape') return
  panel?.classList.add('hidden')
  trigger?.setAttribute('aria-expanded', 'false')
})
</script>
