---
import ThemeToggle from '@/components/ThemeToggle.astro'
import LanguageToggle from '@/components/LanguageToggle.astro'
import MenuIcon from '@/assets/Menu.astro'
import SunIcon from '@/assets/Sun.astro'
import MoonIcon from '@/assets/Moon.astro'
import { getLangFromUrl, getLocalizedPath, useTranslations } from '@/i18n/utils'
import { languages } from '@/i18n/ui'

const lang = getLangFromUrl(Astro.url)
const otherLang = lang === 'es' ? 'en' : 'es'
const t = useTranslations(lang)
---

<header class="fixed inset-x-4 top-4 z-50 flex justify-end transform-gpu will-change-transform md:justify-center">
  <div class="relative">
    <nav
      class="flex size-10 flex-row items-center justify-center rounded-full p-0
      md:size-auto md:gap-5 md:px-5 md:pr-5 md:py-1 md:leading-none
      bg-white/55 backdrop-blur-xl backdrop-saturate-200 border border-white/5 shadow-[0_10px_35px_rgba(15,23,42,0.16),inset_0_1px_0_rgba(255,255,255,0.82)]
      text-[14px] text-slate-700 hover:text-slate-950
      dark:bg-white/[0.08] dark:backdrop-saturate-100 dark:border-white/15 dark:shadow-[0_10px_35px_rgba(0,0,0,0.22),inset_0_1px_0_rgba(255,255,255,0.18)] dark:text-white/90 dark:hover:text-white"
    >
      <a href="#inicio" class="hidden whitespace-nowrap font-medium transition-colors duration-200 md:inline"> {t('nav.home')} </a>
      <a href="#experience" class="hidden whitespace-nowrap font-medium transition-colors duration-200 md:inline"> {t('nav.experience')} </a>
      <a href="#projects" class="hidden whitespace-nowrap font-medium transition-colors duration-200 md:inline"> {t('nav.projects')} </a>
      <a href="#stack" class="hidden whitespace-nowrap font-medium transition-colors duration-200 md:inline"> {t('nav.stack')} </a>
      <span aria-hidden="true" class="hidden h-4 w-px bg-slate-900/15 md:block dark:bg-white/15"></span>

      <div class="hidden md:flex items-center gap-2">
        <LanguageToggle />
        <ThemeToggle />
      </div>

      <button
        id="controls-trigger"
        type="button"
        aria-label={t('nav.settings')}
        aria-haspopup="true"
        aria-expanded="false"
        class="md:hidden grid size-6 place-items-center text-slate-800 transition hover:scale-110 hover:text-slate-950
        focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-sky-500
        dark:text-white dark:hover:text-white"
      >
        <MenuIcon class="size-4.5" aria-hidden="true" />
      </button>
    </nav>

    <div
      id="controls-panel"
      inert
      class="md:!hidden absolute right-0 top-[calc(100%+0.5rem)] w-36 flex flex-col divide-y divide-slate-900/10 overflow-hidden rounded-2xl
      bg-white/55 backdrop-blur-xl backdrop-saturate-200 border border-white/5 shadow-[0_10px_35px_rgba(15,23,42,0.16),inset_0_1px_0_rgba(255,255,255,0.82)]
      dark:bg-white/[0.08] dark:backdrop-saturate-100 dark:border-white/15 dark:shadow-[0_10px_35px_rgba(0,0,0,0.22),inset_0_1px_0_rgba(255,255,255,0.18)] dark:divide-white/15"
    >
      <a
        href={getLocalizedPath(Astro.url, otherLang)}
        aria-label={t('nav.language')}
        class="flex items-center justify-between gap-1 px-3 py-2 transition-colors hover:bg-slate-900/5 dark:hover:bg-white/10"
      >
        <span class="text-[13px] font-medium text-slate-700 dark:text-white/80">{t('controls.language')}</span>
        <span class="text-[12px] font-semibold text-slate-800 dark:text-white">{languages[otherLang]}</span>
      </a>
      <button
        type="button"
        data-theme-toggle
        aria-label={t('theme.toggle')}
        class="flex items-center justify-between gap-1 px-3 py-2 transition-colors hover:bg-slate-900/5 dark:hover:bg-white/10"
      >
        <span class="text-[13px] font-medium text-slate-700 dark:text-white/80">{t('controls.theme')}</span>
        <span class="grid size-5 place-items-center text-slate-800 dark:text-white">
          <SunIcon class="size-4.5 dark:hidden" aria-hidden="true" />
          <MoonIcon class="hidden size-4.5 dark:block" aria-hidden="true" />
        </span>
      </button>
    </div>
  </div>
</header>

<script>
const trigger = document.getElementById('controls-trigger')
const panel = document.getElementById('controls-panel')

function setOpen (isOpen: boolean) {
  panel?.toggleAttribute('data-open', isOpen)
  panel?.toggleAttribute('inert', !isOpen)
  trigger?.setAttribute('aria-expanded', String(isOpen))
}

trigger?.addEventListener('click', (event) => {
  event.stopPropagation()
  setOpen(!panel?.hasAttribute('data-open'))
})

document.addEventListener('click', (event) => {
  if (!panel?.hasAttribute('data-open')) return
  const target = event.target as Node | null
  if (panel.contains(target) || trigger?.contains(target)) return
  setOpen(false)
})

document.addEventListener('keydown', (event) => {
  if (event.key !== 'Escape') return
  setOpen(false)
})
</script>
