---
import '../styles/global.css'
import '@fontsource-variable/onest'
import Analytics from '@vercel/analytics/astro'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import { getLangFromUrl, getLocalizedPath } from '@/i18n/utils'
import AvatarLight from '@/assets/img/avatar-light.webp'

const { title, description } = Astro.props
const lang = getLangFromUrl(Astro.url)
const site = Astro.site ?? new URL('https://www.omancilla.dev')
const canonicalUrl = new URL(Astro.url.pathname, site)
const spanishUrl = new URL(getLocalizedPath(Astro.url, 'es'), site)
const englishUrl = new URL(getLocalizedPath(Astro.url, 'en'), site)
const profileImageUrl = new URL(AvatarLight.src, site)
const socialImageUrl = new URL(lang === 'es' ? '/og-image.png' : '/og-image-en.png', site)
const ogLocale = lang === 'es' ? 'es_MX' : 'en_US'
const alternateOgLocale = lang === 'es' ? 'en_US' : 'es_MX'
const role = lang === 'es' ? 'Desarrollador FullStack' : 'FullStack Developer'
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site.href}#website`,
      url: site.href,
      name: 'Omar Mancilla',
      alternateName: 'Omancilla',
      inLanguage: ['es-MX', 'en']
    },
    {
      '@type': 'ProfilePage',
      '@id': `${canonicalUrl.href}#profile`,
      url: canonicalUrl.href,
      name: title,
      description,
      inLanguage: lang === 'es' ? 'es-MX' : 'en',
      isPartOf: { '@id': `${site.href}#website` },
      mainEntity: { '@id': `${site.href}#omar-mancilla` }
    },
    {
      '@type': 'Person',
      '@id': `${site.href}#omar-mancilla`,
      name: 'Omar Mancilla',
      alternateName: '@omancilla',
      url: site.href,
      image: profileImageUrl.href,
      jobTitle: role,
      homeLocation: {
        '@type': 'Country',
        name: lang === 'es' ? 'México' : 'Mexico'
      },
      sameAs: [
        'https://github.com/omancillav',
        'https://www.linkedin.com/in/omancilla'
      ]
    }
  ]
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es-MX" href={spanishUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="x-default" href={spanishUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <script is:inline>
      ;(function () {
        const mq = window.matchMedia('(prefers-color-scheme: dark)')

        // Carga inicial: respetar localStorage, si no hay valor seguir al sistema
        const stored = localStorage.getItem('theme')
        const isDark = stored === 'dark' || (!stored && mq.matches)
        document.documentElement.classList.toggle('dark', isDark)

        // Cambio de tema del OS: sincronizar app y persistir el nuevo valor
        mq.addEventListener('change', (e) => {
          document.documentElement.classList.toggle('dark', e.matches)
          localStorage.setItem('theme', e.matches ? 'dark' : 'light')
        })
      })()
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f8fafc" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#020617" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content="Omar Mancilla" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Omar Mancilla" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={alternateOgLocale} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={`Omar Mancilla — ${role}`} />
    <meta property="profile:first_name" content="Omar" />
    <meta property="profile:last_name" content="Mancilla" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={`Omar Mancilla — ${role}`} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    <title>{title}</title>
  </head>
  <body class="relative isolate bg-slate-100 text-slate-950 transition-colors duration-300">
    <Analytics debug={false} />
    <div
      class="absolute top-0 bottom-0 z-[-2] min-h-screen w-full bg-sky-50
      bg-[radial-gradient(ellipse_85%_70%_at_50%_-18%,rgba(56,189,248,0.34),rgba(224,242,254,0.18)_48%,rgba(248,250,252,0)_78%),linear-gradient(180deg,#dbeafe_0%,#e0f2fe_32%,#f0f9ff_62%,#f8fafc_100%)]
      transition-colors duration-300
      dark:bg-[#020617] dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(37,99,235,0.5),rgba(2,6,23,0))]"
    >
    </div>
    <Header />
    <slot />
    <Footer />
    <script>
      const REVEAL_OPTIONS = { threshold: 0, rootMargin: '0px 0px -5% 0px' }
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      const targets = document.querySelectorAll('[data-reveal]')

      function onIntersect (entries: IntersectionObserverEntry[], observer: IntersectionObserver) {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return
          entry.target.classList.add('is-visible')
          observer.unobserve(entry.target)
        })
      }

      if (reduceMotion || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-visible'))
      } else {
        const observer = new IntersectionObserver(onIntersect, REVEAL_OPTIONS)
        targets.forEach((el) => observer.observe(el))
      }
    </script>
  </body>
</html>

<style>
  html,
  body {
    scrollbar-width: thin;
    font-family: "Onest Variable", system-ui, sans-serif;
    margin: 0;
    width: 100%;
    min-height: 100%;
    min-height: 100svh;
    scroll-behavior: smooth;
    overflow-x: hidden;
  }

  html {
    color-scheme: light;
    background-color: #f8fafc;
  }

  html.dark {
    color-scheme: dark;
    background-color: #020617;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
