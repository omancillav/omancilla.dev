---
import '../styles/global.css'
import '@fontsource-variable/onest'
import Analytics from '@vercel/analytics/astro'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import { getLangFromUrl, getLocalizedPath } from '@/i18n/utils'

const { title, description } = Astro.props
const lang = getLangFromUrl(Astro.url)
---

<!doctype html>
<html lang={lang}>
  <head>
    <link rel="alternate" hreflang="es" href={new URL(getLocalizedPath(Astro.url, 'es'), Astro.site ?? Astro.url.origin)} />
    <link rel="alternate" hreflang="en" href={new URL(getLocalizedPath(Astro.url, 'en'), Astro.site ?? Astro.url.origin)} />
    <link rel="alternate" hreflang="x-default" href={new URL(getLocalizedPath(Astro.url, 'es'), Astro.site ?? Astro.url.origin)} />
    <script is:inline>
      ;(function () {
        const mq = window.matchMedia('(prefers-color-scheme: dark)')

        // Carga inicial: respetar localStorage, si no hay valor seguir al sistema
        const stored = localStorage.getItem('theme')
        const isDark = stored === 'dark' || (!stored && mq.matches)
        document.documentElement.classList.toggle('dark', isDark)

        // Cambio de tema del OS: sincronizar app y persistir el nuevo valor
        mq.addEventListener('change', (e) => {
          document.documentElement.classList.toggle('dark', e.matches)
          localStorage.setItem('theme', e.matches ? 'dark' : 'light')
        })
      })()
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/webp" href="/logo.webp" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="relative bg-slate-100 text-slate-950 transition-colors duration-300">
    <Analytics debug={false} />
    <div
      class="absolute top-0 bottom-0 z-[-2] min-h-screen w-full bg-sky-50
      bg-[radial-gradient(ellipse_85%_70%_at_50%_-18%,rgba(56,189,248,0.34),rgba(224,242,254,0.18)_48%,rgba(248,250,252,0)_78%),linear-gradient(180deg,#dbeafe_0%,#e0f2fe_32%,#f0f9ff_62%,#f8fafc_100%)]
      transition-colors duration-300
      dark:bg-[#020617] dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(37,99,235,0.5),rgba(2,6,23,0))]"
    >
    </div>
    <Header />
    <slot />
    <Footer />
    <script>
      const REVEAL_OPTIONS = { threshold: 0, rootMargin: '0px 0px -5% 0px' }
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
      const targets = document.querySelectorAll('[data-reveal]')

      function onIntersect (entries, observer) {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return
          entry.target.classList.add('is-visible')
          observer.unobserve(entry.target)
        })
      }

      if (reduceMotion || !('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('is-visible'))
      } else {
        const observer = new IntersectionObserver(onIntersect, REVEAL_OPTIONS)
        targets.forEach((el) => observer.observe(el))
      }
    </script>
  </body>
</html>

<style>
  html,
  body {
    scrollbar-width: thin;
    font-family: "Onest Variable", system-ui, sans-serif;
    margin: 0;
    width: 100%;
    min-height: 100%;
    min-height: 100svh;
    scroll-behavior: smooth;
    overflow-x: hidden;
  }

  html {
    color-scheme: light;
  }

  html.dark {
    color-scheme: dark;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
